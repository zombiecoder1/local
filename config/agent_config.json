{
    "description": "ZombieCoder Agent Configuration - Multi-Server Support",
    "server": {
        "agent_port": 8001,
        "bind_host": "0.0.0.0"
    },
    "ollama": {
        "enable_auto_detection": true,
        "detection_timeout": 30,
        "preferred_ports": [8007, 8155, 11434],
        "fallback_servers": [
            "http://127.0.0.1:8007",
            "http://127.0.0.1:8155",
            "http://127.0.0.1:11434",
            "http://localhost:8007",
            "http://localhost:8155"
        ]
    },
    "logging": {
        "enabled": true,
        "log_dir": "logs",
        "log_level": "INFO",
        "file_handler": {
            "filename": "logs/zombiecoder_agent.log",
            "max_bytes": 10485760,
            "backup_count": 5
        },
        "console_handler": {
            "enabled": true
        }
    },
    "models": {
        "default_model": "phi-2",
        "max_tokens": 220,
        "temperature": 0.7
    },
    "cors": {
        "origins": [
            "http://localhost:3000",
            "http://localhost:8001",
            "http://localhost:5010",
            "vscode://"
        ]
    },
    "endpoints": {
        "chat_completions": "/v1/chat/completions",
        "ollama_completion": "/api/ollama/completion",
        "health": "/health",
        "agent_info": "/v1/agent/info"
    }
}

