# ZombieCoder Agent Configuration

# Ollama Server Configuration
# Supported ports: 8007 (default), 8155, 11434
# The agent will auto-detect available Ollama servers
OLLAMA_URL=http://127.0.0.1:8007
OLLAMA_PORT=8007

# Agent Server Port
AGENT_PORT=8001

# Default Model
DEFAULT_MODEL=microsoft/phi-2
BANGLA_LLM_MODEL=microsoft/phi-2

# Model Configuration
BANGLA_MAX_NEW_TOKENS=220
BANGLA_MODEL_TEMPERATURE=0.7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,vscode://

# Server Detection
# If set to true, agent will wait for any Ollama server to be available
WAIT_FOR_OLLAMA=true
OLLAMA_DETECTION_TIMEOUT=30
